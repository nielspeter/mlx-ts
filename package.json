{
  "name": "@nielspeter/mlx-ts",
  "version": "0.4.1",
  "description": "A TypeScript MLX SDK over Apple's mlx-c via FFI \u2014 Bun, Deno and Node. Apple Silicon only.",
  "license": "MIT",
  "homepage": "https://github.com/nielspeter/mlx-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nielspeter/mlx-ts.git"
  },
  "bugs": {
    "url": "https://github.com/nielspeter/mlx-ts/issues"
  },
  "author": "Niels Peter Strandberg",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "mlx",
    "mlx-lm",
    "mlx-whisper",
    "apple-silicon",
    "metal",
    "llm",
    "inference",
    "training",
    "lora",
    "ffi",
    "typescript",
    "bun",
    "deno",
    "node"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "audit": "bun tools/audit.ts",
    "test": "bun test tests/",
    "validate": "bash scripts/validate-all.sh",
    "prepack": "bun tools/codegen.ts && tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "build:platform": "bash tools/fetch-prebuilds.sh && bash tools/make-platform-package.sh",
    "lint": "biome check --formatter-enabled=false .",
    "lint:fix": "biome check --write --formatter-enabled=false .",
    "format": "biome format --write ."
  },
  "optionalDependencies": {
    "koffi": "^3.1.6",
    "@nielspeter/mlx-ts-darwin-arm64": "0.1.0",
    "@huggingface/jinja": "^0.5.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
