{
  "name": "@nielspeter/mlx-ts",
  "version": "0.1.0",
  "description": "A TypeScript MLX SDK over Apple's mlx-c via FFI \u2014 Bun, Deno and Node. Apple Silicon only.",
  "license": "MIT",
  "author": "Niels Peter Strandberg",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "mlx",
    "mlx-lm",
    "mlx-whisper",
    "apple-silicon",
    "metal",
    "llm",
    "inference",
    "training",
    "lora",
    "ffi",
    "typescript",
    "bun",
    "deno",
    "node"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "audit": "bun tools/audit.ts",
    "test": "bun test tests/",
    "validate": "bash scripts/validate-all.sh",
    "prepack": "bun tools/codegen.ts && tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@huggingface/jinja": "^0.5.9"
  },
  "optionalDependencies": {
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
